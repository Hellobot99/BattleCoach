# Copy to .env on the server and edit.

# Your address. A domain name (or <public-ip>.sslip.io) gets HTTPS automatically; ":80" serves plain HTTP on the IP.
SITE_ADDRESS=:80

# New battles one address may start per hour (0 = no limit).
GAMES_PER_HOUR=30

# Evaluation load per turn. Defaults (empty) = 24 + 72 rollouts and 32 worlds: best grades, but on 2 vCPU about 6 s a turn.
# Measured on 2 vCPU / 2 GB (Docker on an M4 Mac; real t3 cores are roughly 1.5-2x slower):
#   default 24/72 -> 5.5-6 s · 12/28 -> about 2.2 s · 8/16 -> about 1.4 s (grades get noisier as numbers drop)
# Recommended for t3.small / t4g.small:
EVAL_PHASE1=12
EVAL_PHASE2=28
# Redrawn opponent sets per evaluation (default 32). More costs little CPU and steadies the grades.
EVAL_WORLDS=
# While the player thinks, up to this many extra rounds of 32 rollouts per action in contention (default 3, 0 = off).
EVAL_REFINE=
# Worker threads; empty = CPU count on small servers.
EVAL_WORKERS=
